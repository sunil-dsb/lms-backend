{
  "name": "lms-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Alimentaria Mexicana LMS — backend API",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --watch development.env --ext ts,json,env --exec tsx src/index.ts",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=development.env scripts/seed.ts",
    "test:e2e": "node tests/e2e/run.mjs",
    "admin:promote": "tsx --env-file=development.env scripts/promote-super-admin.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@aws-sdk/s3-request-presigner": "^3.1133.0",
    "@google/genai": "^0.7.0",
    "@sentry/node": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.4",
    "commander": "^15.0.0",
    "cookie": "^1.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "http-status": "^2.1.0",
    "jose": "^6.2.12",
    "mammoth": "^1.8.0",
    "multer": "^2.4.0",
    "nodemon": "^3.1.14",
    "pdf-parse": "^1.1.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "resend": "^6.28.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie": "^1.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@typescript/typescript6": "npm:typescript@^6.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "typescript-eslint>typescript": "$@typescript/typescript6",
      "@typescript-eslint/parser>typescript": "$@typescript/typescript6",
      "@typescript-eslint/typescript-estree>typescript": "$@typescript/typescript6",
      "proxy-addr": "^2.0.8",
      "shell-quote": "^1.11.0"
    }
  }
}
